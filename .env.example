# ---------------------------------------------------------------------------
# CIFRA — Consultoria Tributária de Obra
# Copie este arquivo para .env.local e preencha os valores reais.
# Variáveis NEXT_PUBLIC_* são embutidas no bundle do navegador no momento do
# build — nunca coloque segredos (tokens, chaves privadas) em NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# Número do WhatsApp comercial no formato internacional, somente dígitos.
# Exemplo real: 5511999999999 (55 + DDD + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=55DDDNUMERO

# E-mail comercial exibido no site (opcional; se vazio, o site oculta o e-mail)
NEXT_PUBLIC_CONTACT_EMAIL=

# Redes sociais (opcional; se vazio, o link não é exibido)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# --- Tagflow ---------------------------------------------------------------
# Endpoint público de ingestão. Nunca use uma rota administrativa ou inclua
# token, segredo ou credencial nesta URL.
NEXT_PUBLIC_TAGFLOW_ENABLED=true
NEXT_PUBLIC_TAGFLOW_ENDPOINT=https://SEU-ENDPOINT-TAGFLOW/events
NEXT_PUBLIC_TAGFLOW_SITE_ID=cifra
NEXT_PUBLIC_TAGFLOW_DEBUG=false

# --- Anti-spam (integração futura) -----------------------------------------
# Cloudflare Turnstile — site key pública (a validação do token exige um
# backend/worker; em static export o campo fica preparado, mas inativo)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Deploy ----------------------------------------------------------------
# Só defina se publicar SEM domínio próprio (ex.: avilaops.github.io/cifra)
# NEXT_PUBLIC_BASE_PATH=/cifra
